@using Gym.Application.DailySessions.Commands.CreateDailySession
@model CreateDailySessionCommand

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="receipt-card">
            <div class="receipt-header">
                <h4><i class="bi bi-plus-circle"></i> @SharedLocalizer["New Daily Session"]</h4>
                <span class="receipt-badge">@SharedLocalizer["Trial / One-Day"]</span>
            </div>
            <form asp-action="Create" method="post" class="receipt-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">@SharedLocalizer["Name"] <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="@SharedLocalizer["Visitor name"]" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">@SharedLocalizer["Phone"] <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control" placeholder="@SharedLocalizer["Phone number"]" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="VisitDate" class="form-label">@SharedLocalizer["Visit Date"] <span class="text-danger">*</span></label>
                        <input asp-for="VisitDate" type="date" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="VisitDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PlanId" class="form-label">@SharedLocalizer["Plan"]</label>
                        <select asp-for="PlanId" asp-items="ViewBag.Plans" class="form-select" id="planSelect">
                            <option value="">@SharedLocalizer["Select a plan"]</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PaymentMethod" class="form-label">@SharedLocalizer["Payment Method"] <span class="text-danger">*</span></label>
                        <select asp-for="PaymentMethod" asp-items="ViewBag.PaymentMethods" class="form-select">
                            <option value="">@SharedLocalizer["Select payment method"]</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label">@SharedLocalizer["Amount"] <span class="text-danger">*</span></label>
                        <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" placeholder="@SharedLocalizer["0.00"]" id="amountInput" readonly />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaidAmount" class="form-label">@SharedLocalizer["Paid Amount"] <span class="text-danger">*</span></label>
                        <input asp-for="PaidAmount" type="number" step="0.01" min="0" class="form-control" placeholder="@SharedLocalizer["0.00"]" />
                        <span asp-validation-for="PaidAmount" class="text-danger small"></span>
                    </div>
                </div>
                <div class="receipt-footer px-0 pb-0 mt-3">
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg"></i> @SharedLocalizer["Cancel"]</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> @SharedLocalizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('planSelect')?.addEventListener('change', function() {
        var planId = this.value;
        var amountInput = document.getElementById('amountInput');
        if (!planId) { amountInput.value = ''; return; }
        fetch('@Url.Action("GetPlanPrice", "DailySessions")?planId=' + planId)
            .then(r => r.json())
            .then(d => { amountInput.value = d.price != null ? d.price : ''; })
            .catch(() => {});
    });
</script>
