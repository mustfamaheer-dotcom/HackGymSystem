@model PaginatedResult<SubscriptionDto>
@{
    var searchTerm = ViewBag.SearchTerm as string;
    var statusFilter = ViewBag.StatusFilter as SubscriptionStatus?;
    var dateFrom = ViewBag.DateFrom as string;
    var dateTo = ViewBag.DateTo as string;
    var expiresWithin = ViewBag.ExpiresWithinDays as int?;
    var hasOutstanding = ViewBag.HasOutstandingBalance as bool?;
    var showFilters = !string.IsNullOrEmpty(searchTerm) || statusFilter.HasValue || !string.IsNullOrEmpty(dateFrom) || !string.IsNullOrEmpty(dateTo) || expiresWithin.HasValue || hasOutstanding == true;
}

<div class="receipt-card">
    <div class="receipt-header">
        <h4><i class="bi bi-journal-text"></i> @SharedLocalizer["Subscriptions"]</h4>
        <a asp-action="Create" class="btn btn-gold"><i class="bi bi-plus-lg"></i> @SharedLocalizer["New Subscription"]</a>
    </div>

    @* WhatsApp Template Selector & Bulk Send *@
    <div class="p-3 border-bottom bg-light">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-whatsapp text-success"></i></span>
                    <select id="whatsappTemplate" class="form-select">
                        <option value="">@SharedLocalizer["Select WhatsApp template..."]</option>
                        @if (ViewBag.WhatsAppTemplates is SelectList tpls)
                        {
                            foreach (var t in tpls)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <button type="button" id="sendBulkWhatsAppBtn" class="btn btn-success w-100" disabled>
                    <i class="bi bi-whatsapp"></i> <span id="bulkSelectedCount">0</span> @SharedLocalizer["selected — Send Bulk WhatsApp"]
                </button>
            </div>
            <div class="col-md-4 text-muted small d-flex align-items-center">
                <i class="bi bi-info-circle me-1"></i> @SharedLocalizer["Select a template, check subscriptions, then click Send Bulk WhatsApp"]
            </div>
        </div>
    </div>

    @* Search & Filters *@
    <div class="p-3 border-bottom bg-light" style="border-top:1px solid var(--border-solid);">
        <form asp-action="Index" method="get" id="filterForm">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <input type="text" name="SearchTerm" class="form-control" placeholder="@SharedLocalizer["Search by name, receipt or phone..."]" value="@searchTerm" />
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="pageSize" class="form-select" onchange="this.form.submit()">
                        <option value="10" selected="@(Model?.PageSize == 10 ? true : null)">@SharedLocalizer["10 per page"]</option>
                        <option value="20" selected="@(Model?.PageSize == 20 ? true : null)">@SharedLocalizer["20 per page"]</option>
                        <option value="50" selected="@(Model?.PageSize == 50 ? true : null)">@SharedLocalizer["50 per page"]</option>
                    </select>
                </div>
                <div class="col-md-5 text-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" data-bs-toggle="collapse" data-bs-target="#advancedFilters" aria-expanded="@(showFilters ? "true" : "false")">
                        <i class="bi @(showFilters ? "bi-chevron-up" : "bi-funnel")"></i> @SharedLocalizer["Filters"]
                    </button>
                    <a asp-action="Index" class="btn btn-outline-danger btn-sm rounded-pill @(showFilters ? "" : "d-none")" id="clearFiltersBtn">
                        <i class="bi bi-x-lg"></i> @SharedLocalizer["Clear"]
                    </a>
                </div>
            </div>

            @* Advanced Filters Panel *@
            <div class="collapse @(showFilters ? "show" : "") mt-3" id="advancedFilters">
                <div class="card card-body border-0 bg-white shadow-sm p-3">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted mb-1">@SharedLocalizer["Status"]</label>
                            <select name="StatusFilter" class="form-select">
                                <option value="">@SharedLocalizer["All Statuses"]</option>
                                @foreach (var s in Enum.GetValues<SubscriptionStatus>())
                                {
                                    <option value="@s" selected="@(statusFilter == s ? true : null)">@SharedLocalizer[s.ToString()]</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted mb-1">@SharedLocalizer["From Date"]</label>
                            <input type="date" name="DateFrom" class="form-control" value="@dateFrom" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted mb-1">@SharedLocalizer["To Date"]</label>
                            <input type="date" name="DateTo" class="form-control" value="@dateTo" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted mb-1">@SharedLocalizer["Expires Within (Days)"]</label>
                            <input type="number" name="ExpiresWithinDays" class="form-control" min="1" value="@expiresWithin" placeholder="@SharedLocalizer["e.g. 7"]" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input type="checkbox" name="HasOutstandingBalance" value="true" id="hasOutstandingCheck" class="form-check-input" checked="@(hasOutstanding == true ? true : null)" />
                                <label class="form-check-label small" for="hasOutstandingCheck">
                                    @SharedLocalizer["Show only members with remaining balance"]
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> @SharedLocalizer["Apply Filters"]</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    @* Flash Messages *@
    @* Empty State *@
    @if (Model is null || Model.Items.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-journal-text" style="font-size: 3rem;"></i>
            <p class="mt-2">@SharedLocalizer["No subscriptions found."]</p>
        </div>
    }
    else
    {
        <style>
            tr.wa-selected td { background-color: rgba(0, 0, 0, 0.2) !important; }
            @@media (prefers-color-scheme: dark) { tr.wa-selected td { background-color: rgba(200, 200, 200, 0.25) !important; } }
        </style>
        @* Table *@
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:40px;">
                            <input type="checkbox" id="selectAllSubscriptions" class="form-check-input" title="@SharedLocalizer["Select all on this page"]" />
                        </th>
                        <th>@SharedLocalizer["Receipt"]</th>
                        <th>@SharedLocalizer["Member"]</th>
                        <th>@SharedLocalizer["Phone"]</th>
                        <th>@SharedLocalizer["Plan"]</th>
                        <th>@SharedLocalizer["Expiration"]</th>
                        <th>@SharedLocalizer["Paid"]</th>
                        <th>@SharedLocalizer["Remaining"]</th>
                        <th>@SharedLocalizer["Status"]</th>
                        <th class="text-center">@SharedLocalizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input subscription-bulk-checkbox"
                                    data-phone="@item.MemberPhone"
                                    data-member="@item.MemberName"
                                    data-membercode="@item.MemberCode"
                                    data-joindate="@item.MemberRegistrationDate.ToString("dd/MM/yyyy")"
                                    data-receipt="@item.ReceiptNumber"
                                    data-expiration="@item.ExpirationDate.ToString("dd/MM/yyyy")"
                                    data-daysremaining="@((int)(item.ExpirationDate - DateTime.UtcNow).TotalDays)"
                                    data-status="@item.Status.ToString()"
                                    data-totalpaid="@item.TotalSubscriptionValue.ToString("N2")"
                                    data-amountpaid="@item.AmountPaid.ToString("N2")"
                                    data-remainingbalance="@item.RemainingBalance.ToString("N2")"
                                    data-lastpaymentamount="@(item.LastPaymentAmount?.ToString("N2") ?? "0")"
                                    data-lastpaymentdate="@(item.LastPaymentDate?.ToString("dd/MM/yyyy") ?? "")"
                                    data-offers="@(item.OfferTitle ?? "")" />
                            </td>
                            <td><code style="font-size:0.8rem;color:var(--text-secondary);background:var(--light-gray);padding:2px 8px;border-radius:6px;">@item.ReceiptNumber</code></td>
                            <td class="fw-semibold">@item.MemberName</td>
                            <td>@item.MemberPhone</td>
                            <td>@item.PlanName</td>
                            <td>@item.ExpirationDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.AmountPaid.ToString("N2")</td>
                            <td class="@(item.RemainingBalance > 0 ? "text-danger fw-semibold" : "text-success")">@item.RemainingBalance.ToString("N2")</td>
                            <td>
                                <span class="badge-status @(item.Status == SubscriptionStatus.Active ? "badge-active" : item.Status == SubscriptionStatus.Frozen ? "badge-warning" : item.Status == SubscriptionStatus.Expired ? "badge-expired" : "badge-frozen")">
                                    @SharedLocalizer[item.Status.ToString()]
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="@SharedLocalizer["View"]"><i class="bi bi-eye"></i></a>
                                    <a href="#" class="btn btn-success wa-btn" title="@SharedLocalizer["WhatsApp"]"
                                       data-phone="@item.MemberPhone"
                                       data-member="@item.MemberName"
                                       data-membercode="@item.MemberCode"
                                       data-joindate="@item.MemberRegistrationDate.ToString("dd/MM/yyyy")"
                                       data-receipt="@item.ReceiptNumber"
                                       data-expiration="@item.ExpirationDate.ToString("dd/MM/yyyy")"
                                       data-daysremaining="@((int)(item.ExpirationDate - DateTime.UtcNow).TotalDays)"
                                       data-status="@item.Status.ToString()"
                                       data-totalpaid="@item.TotalSubscriptionValue.ToString("N2")"
                                       data-amountpaid="@item.AmountPaid.ToString("N2")"
                                       data-remainingbalance="@item.RemainingBalance.ToString("N2")"
                                       data-lastpaymentamount="@(item.LastPaymentAmount?.ToString("N2") ?? "0")"
                                       data-lastpaymentdate="@(item.LastPaymentDate?.ToString("dd/MM/yyyy") ?? "")"
                                       data-offers="@(item.OfferTitle ?? "")"><i class="bi bi-whatsapp"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Pagination *@
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <small class="text-muted">@SharedLocalizer["Showing"] @Model.Items.Count @SharedLocalizer["of"] @Model.TotalCount @SharedLocalizer["subscriptions"]</small>
            <nav>
                <ul class="pagination pagination-sm">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-SearchTerm="@searchTerm" asp-route-StatusFilter="@statusFilter" asp-route-DateFrom="@dateFrom" asp-route-DateTo="@dateTo" asp-route-ExpiresWithinDays="@expiresWithin" asp-route-Page="@(Model.Page - 1)" asp-route-PageSize="@Model.PageSize">@SharedLocalizer["Previous"]</a>
                        </li>
                    }
                    @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-SearchTerm="@searchTerm" asp-route-StatusFilter="@statusFilter" asp-route-DateFrom="@dateFrom" asp-route-DateTo="@dateTo" asp-route-ExpiresWithinDays="@expiresWithin" asp-route-Page="@i" asp-route-PageSize="@Model.PageSize">@i</a>
                        </li>
                    }
                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-SearchTerm="@searchTerm" asp-route-StatusFilter="@statusFilter" asp-route-DateFrom="@dateFrom" asp-route-DateTo="@dateTo" asp-route-ExpiresWithinDays="@expiresWithin" asp-route-Page="@(Model.Page + 1)" asp-route-PageSize="@Model.PageSize">@SharedLocalizer["Next"]</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script type="application/json" id="subscriptionsIndex-templateData">@Html.Raw(ViewBag.WhatsAppTemplateJson ?? "[]")</script>
    <script type="application/json" id="subscriptionsIndex-activeOffers">@Html.Raw(ViewBag.ActiveOffersJson ?? "[]")</script>
    <script>
        (function() {
            var templateData = JSON.parse(document.getElementById('subscriptionsIndex-templateData').textContent);
            var templateMap = {};
            templateData.forEach(function(t) { templateMap[t.Id] = t.MessageBody; });

            var activeOffers = JSON.parse(document.getElementById('subscriptionsIndex-activeOffers').textContent);
            function formatOffers() {
                if (!activeOffers || activeOffers.length === 0) return '@SharedLocalizer["No offers available"]';
                return activeOffers.map(function(o) {
                    var lines = ['▸ ' + o.OfferTitle];
                    var details = [];
                    if (o.OfferPrice != null) details.push('@SharedLocalizer["Price"]: ' + Number(o.OfferPrice).toLocaleString() + ' @SharedLocalizer["EGP"]');
                    if (o.OfferType === 'FixedPrice') {
                        details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Fixed Price"]');
                    } else if (o.OfferType === 'BonusDuration') {
                        var bonus = [];
                        if (o.BonusMonths) bonus.push('+' + o.BonusMonths + ' @SharedLocalizer["month(s)"]');
                        if (o.BonusDays) bonus.push('+' + o.BonusDays + ' @SharedLocalizer["day(s)"]');
                        if (bonus.length) details.push('@SharedLocalizer["Bonus"]: ' + bonus.join(' + '));
                        details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Bonus Duration"]');
                    } else if (o.OfferType === 'FreeRegistration') {
                        details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Free Registration"]');
                    } else if (o.OfferType === 'ExtraFreeze') {
                        if (o.ExtraFreezeDays) details.push('@SharedLocalizer["Extra Freeze"]: +' + (o.ExtraFreezeDays || 0) + ' @SharedLocalizer["day(s)"]');
                        details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Extra Freeze"]');
                    }
                    if (details.length) lines.push('  ' + details.join(', '));
                    return lines.join('\n');
                }).join('\n\n');
            }

            var select = document.getElementById('whatsappTemplate');
            var isConfigured = @(ViewBag.IsWhatsAppConfigured ? "true" : "false");

            function sendSingleWhatsApp(btn) {
                var tid = select ? select.value : '';
                if (!tid) {
                    showAlertModal('@SharedLocalizer["Please select a WhatsApp template first"]');
                    return;
                }

                var body = templateMap[tid] || '';
                var msg = body
                    .replace(/\{MemberName\}/g, btn.dataset.member || '')
                    .replace(/\{MemberCode\}/g, btn.dataset.membercode || '')
                    .replace(/\{JoinDate\}/g, btn.dataset.joindate || '')
                    .replace(/\{ReceiptNumber\}/g, btn.dataset.receipt || '')
                    .replace(/\{StartDate\}/g, '')
                    .replace(/\{ExpirationDate\}/g, btn.dataset.expiration || '')
                    .replace(/\{DaysRemaining\}/g, btn.dataset.daysremaining || '')
                    .replace(/\{SubscriptionStatus\}/g, btn.dataset.status || '')
                    .replace(/\{TotalSubscriptionValue\}/g, btn.dataset.totalpaid || '')
                    .replace(/\{TotalPaid\}/g, btn.dataset.amountpaid || '')
                    .replace(/\{AmountPaid\}/g, btn.dataset.amountpaid || '')
                    .replace(/\{RemainingBalance\}/g, btn.dataset.remainingbalance || '')
                    .replace(/\{LastPaymentAmount\}/g, btn.dataset.lastpaymentamount || '')
                    .replace(/\{LastPaymentDate\}/g, btn.dataset.lastpaymentdate || '')
                    .replace(/\{OfferName\}/g, btn.dataset.offers || '')
                    .replace(/\{Offers\}/g, formatOffers())
                    .replace(/\{PdfLink\}/g, '');

                if (!isConfigured) {
                    var phone = (btn.dataset.phone || '').replace(/\D/g, '');
                    if (phone.startsWith('0')) phone = '20' + phone.substring(1);
                    window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(msg), '_blank');
                    return;
                }

                var data = {
                    memberPhone: btn.dataset.phone || '',
                    memberName: btn.dataset.member || '',
                    memberCode: btn.dataset.membercode || '',
                    joinDate: btn.dataset.joindate || '',
                    receiptNumber: btn.dataset.receipt || '',
                    expirationDate: btn.dataset.expiration || '',
                    daysRemaining: btn.dataset.daysremaining || '',
                    subscriptionStatus: btn.dataset.status || '',
                    totalPaid: btn.dataset.amountpaid || '',
                    remainingBalance: btn.dataset.remainingbalance || '',
                    lastPayment: btn.dataset.lastpaymentamount || '',
                    lastPaymentDate: btn.dataset.lastpaymentdate || '',
                    offers: formatOffers()
                };
                fetch('/api/whatsapp/send-member?templateBody=' + encodeURIComponent(msg) + '&language=ar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                    body: JSON.stringify(data)
                }).then(function(r) { return r.json(); }).then(function(r) {
                    if (r.success) showAlertModal('@SharedLocalizer["WhatsApp message sent successfully"]');
                    else showAlertModal('@SharedLocalizer["Failed to send WhatsApp message"]: ' + (r.message || ''));
                }).catch(function() {
                    showAlertModal('@SharedLocalizer["Failed to send WhatsApp message"]');
                });
            }

            document.addEventListener('click', function(e) {
                var btn = e.target.closest('.wa-btn');
                if (!btn) return;
                e.preventDefault();
                sendSingleWhatsApp(btn);
            });

            function buildBulkMessage(cb, body, offersText) {
                return body
                    .replace(/\{MemberName\}/g, cb.dataset.member || '')
                    .replace(/\{MemberCode\}/g, cb.dataset.membercode || '')
                    .replace(/\{JoinDate\}/g, cb.dataset.joindate || '')
                    .replace(/\{ReceiptNumber\}/g, cb.dataset.receipt || '')
                    .replace(/\{StartDate\}/g, '')
                    .replace(/\{ExpirationDate\}/g, cb.dataset.expiration || '')
                    .replace(/\{DaysRemaining\}/g, cb.dataset.daysremaining || '')
                    .replace(/\{SubscriptionStatus\}/g, cb.dataset.status || '')
                    .replace(/\{TotalSubscriptionValue\}/g, cb.dataset.totalpaid || '')
                    .replace(/\{TotalPaid\}/g, cb.dataset.amountpaid || '')
                    .replace(/\{AmountPaid\}/g, cb.dataset.amountpaid || '')
                    .replace(/\{RemainingBalance\}/g, cb.dataset.remainingbalance || '')
                    .replace(/\{LastPaymentAmount\}/g, cb.dataset.lastpaymentamount || '')
                    .replace(/\{LastPaymentDate\}/g, cb.dataset.lastpaymentdate || '')
                    .replace(/\{OfferName\}/g, cb.dataset.offers || '')
                    .replace(/\{Offers\}/g, offersText)
                    .replace(/\{PdfLink\}/g, '');
            }

            function updateBulkCount() {
                var checked = document.querySelectorAll('.subscription-bulk-checkbox:checked');
                var count = checked.length;
                var counter = document.getElementById('bulkSelectedCount');
                if (counter) counter.textContent = count;
                var btn = document.getElementById('sendBulkWhatsAppBtn');
                if (btn) {
                    btn.disabled = count === 0;
                    btn.classList.toggle('btn-success', count > 0);
                    btn.classList.toggle('btn-secondary', count === 0);
                }
            }

            var selectAll = document.getElementById('selectAllSubscriptions');
            if (selectAll) {
                selectAll.addEventListener('change', function() {
                    document.querySelectorAll('.subscription-bulk-checkbox').forEach(function(cb) { cb.checked = selectAll.checked; });
                    updateBulkCount();
                });
            }

            document.addEventListener('change', function(e) {
                if (e.target && e.target.classList && e.target.classList.contains('subscription-bulk-checkbox')) {
                    updateBulkCount();
                }
            });

            var bulkBtn = document.getElementById('sendBulkWhatsAppBtn');
            if (bulkBtn) {
                bulkBtn.addEventListener('click', function() {
                    var tid = select ? select.value : '';
                    if (!tid) {
                        showAlertModal('@SharedLocalizer["Please select a WhatsApp template first"]');
                        return;
                    }
                    var body = templateMap[tid] || '';
                    var checked = document.querySelectorAll('.subscription-bulk-checkbox:checked');
                    if (checked.length === 0) return;

                    if (!isConfigured) {
                        var delay = 0;
                        var step = 400;
                        checked.forEach(function(cb) {
                            var msg = buildBulkMessage(cb, body, formatOffers());
                            var phone = (cb.dataset.phone || '').replace(/\D/g, '');
                            if (phone.startsWith('0')) phone = '20' + phone.substring(1);
                            if (!phone) return;
                            var row = cb.closest('tr');
                            if (row) row.classList.add('wa-selected');
                            setTimeout(function() {
                                window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(msg), '_blank');
                            }, delay);
                            delay += step;
                        });
                        setTimeout(function() {
                            var n = checked.length;
                            showAlertModal('@SharedLocalizer["Bulk WhatsApp opened for "].Value' + n + ' @SharedLocalizer["subscriptions. Check your browser tabs."].Value');
                        }, delay + 200);
                        return;
                    }

                    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    var sent = 0, failed = 0;
                    checked.forEach(function(cb) {
                        var msg = buildBulkMessage(cb, body, formatOffers());
                        var data = {
                            memberPhone: cb.dataset.phone || '',
                            memberName: cb.dataset.member || '',
                            memberCode: cb.dataset.membercode || '',
                            joinDate: cb.dataset.joindate || '',
                            receiptNumber: cb.dataset.receipt || '',
                            expirationDate: cb.dataset.expiration || '',
                            daysRemaining: cb.dataset.daysremaining || '',
                            subscriptionStatus: cb.dataset.status || '',
                            totalPaid: cb.dataset.amountpaid || '',
                            remainingBalance: cb.dataset.remainingbalance || '',
                            lastPayment: cb.dataset.lastpaymentamount || '',
                            lastPaymentDate: cb.dataset.lastpaymentdate || '',
                            offers: formatOffers()
                        };
                        var row = cb.closest('tr');
                        if (row) row.classList.add('wa-selected');
                        fetch('/api/whatsapp/send-member?templateBody=' + encodeURIComponent(msg) + '&language=ar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                            body: JSON.stringify(data)
                        }).then(function(r) { return r.json(); }).then(function(r) {
                            if (r.success) sent++; else failed++;
                        }).catch(function() { failed++; });
                    });
                    setTimeout(function() {
                        showAlertModal(sent + ' @SharedLocalizer["sent, "] ' + failed + ' @SharedLocalizer["failed"]');
                    }, 2000);
                });
            }

            updateBulkCount();
        })();
    </script>
}
