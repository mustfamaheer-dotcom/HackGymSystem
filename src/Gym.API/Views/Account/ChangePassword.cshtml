@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "";
    Layout = "_Layout";
    var error = ViewBag.Error as string;
    var success = TempData["Success"] as string;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h4 class="card-title text-center mb-4">@SharedLocalizer["Change Password"]</h4>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger">@error</div>
                    }
                    @if (!string.IsNullOrEmpty(success))
                    {
                        <div class="alert alert-success">@success</div>
                    }

                    <form method="post" action="/Account/ChangePassword">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">@SharedLocalizer["Current Password"]</label>
                            <input type="password" name="currentPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@SharedLocalizer["New Password"]</label>
                            <input type="password" name="newPassword" class="form-control" required minlength="6" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@SharedLocalizer["Confirm New Password"]</label>
                            <input type="password" name="confirmPassword" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@SharedLocalizer["Change Password"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
