@{
    var error = ViewBag.Error as string;
    Layout = null;
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<!DOCTYPE html>
<html lang="@lang" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@SharedLocalizer["Login - Hack Gym"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Inter:wght@400;500;600&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />
    @if (!string.IsNullOrEmpty(ViewBag.CaptchaSiteKey))
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@ViewBag.CaptchaSiteKey"></script>
    }
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        :root {
            --white:#FFFFFF; --off-white:#F8F9FA; --light-gray:#F3F4F6;
            --gold:#FFD54A; --amber:#F4B400; --dark-amber:#E8A800;
            --charcoal:#333333; --soft-gray:#6B7280; --border-light:#E5E7EB;
            --shadow-xs:0 1px 2px rgba(0,0,0,0.03);
            --shadow-sm:0 2px 8px rgba(0,0,0,0.05);
            --shadow-md:0 8px 30px rgba(0,0,0,0.06);
            --shadow-lg:0 20px 60px rgba(0,0,0,0.08);
            --shadow-xl:0 30px 80px rgba(0,0,0,0.10);
            --shadow-glow:0 8px 32px rgba(244,180,0,0.22);
            --shadow-glow-hover:0 12px 44px rgba(244,180,0,0.35);
            --radius-sm:10px; --radius-md:14px; --radius-lg:24px; --radius-xl:30px;
            --font-display:'Poppins',system-ui,-apple-system,sans-serif;
            --font-body:'Inter',system-ui,-apple-system,sans-serif;
            --font-arabic:'Tajawal','Poppins',system-ui,sans-serif;
            --t-fast:0.2s cubic-bezier(0.4,0,0.2,1);
            --t-base:0.3s cubic-bezier(0.4,0,0.2,1);
            --t-slow:0.5s cubic-bezier(0.4,0,0.2,1);
        }
        html { height:100%; -webkit-font-smoothing:antialiased; }
        body {
            height:100%; font-family:var(--font-body);
            background:var(--off-white); color:var(--charcoal);
            overflow:hidden; line-height:1.6;
        }

        .split-layout { display:flex; height:100vh; width:100vw; position:relative; }

        /* ===== LEFT PANEL ===== */
        .left-panel {
            flex:0 0 42%; position:relative; display:flex; flex-direction:column;
            justify-content:space-between; align-items:center;
            padding:2.5rem 2.5rem 2rem; overflow:hidden;
            background:linear-gradient(165deg, #FFFAF0 0%, #FFF8E7 20%, #FFF5DD 50%, #FFF8E7 75%, #FFFAF0 100%);
        }
        .left-panel::before {
            content:''; position:absolute; inset:0;
            background:
                radial-gradient(ellipse at 30% 20%, rgba(255,213,74,0.10) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 80%, rgba(244,180,0,0.06) 0%, transparent 50%);
            z-index:1; pointer-events:none;
        }
        .left-panel .bg-dots {
            position:absolute; inset:0;
            background-image:radial-gradient(circle,rgba(244,180,0,0.06) 1px,transparent 1px);
            background-size:32px 32px; z-index:1; pointer-events:none;
        }
        .left-panel .glow-orb {
            position:absolute; width:500px; height:500px; border-radius:50%;
            background:radial-gradient(circle,rgba(255,213,74,0.10) 0%,transparent 55%);
            top:-200px; right:-150px; pointer-events:none; z-index:1;
            animation:orbFloat 10s ease-in-out infinite alternate;
        }
        .left-panel .glow-orb-2 {
            position:absolute; width:400px; height:400px; border-radius:50%;
            background:radial-gradient(circle,rgba(255,213,74,0.07) 0%,transparent 55%);
            bottom:-180px; left:-120px; pointer-events:none; z-index:1;
            animation:orbFloat 14s ease-in-out infinite alternate-reverse;
        }
        @@keyframes orbFloat {
            0% { transform:translate(0,0) scale(1); }
            100% { transform:translate(30px,-30px) scale(1.1); }
        }

        .left-content {
            position:relative; z-index:2; width:100%; max-width:460px;
            flex:1; display:flex; flex-direction:column; justify-content:center;
            opacity:0; animation:contentIn 0.7s ease 0.1s forwards;
        }
        @@keyframes contentIn {
            from { opacity:0; transform:translateY(24px); }
            to { opacity:1; transform:translateY(0); }
        }

        .left-content .logo-wrap {
            display:flex; justify-content:center; margin-bottom:1.75rem;
        }
        .left-content .logo-wrap img {
            height:120px; width:auto; border-radius:16px;
            filter:drop-shadow(0 6px 20px rgba(244,180,0,0.15));
            transition:transform var(--t-base);
        }
        .left-content .logo-wrap img:hover { transform:scale(1.05); }

        .left-content .headline {
            font-family:var(--font-display); font-weight:800;
            font-size:2.4rem; line-height:1.15; color:var(--charcoal);
            margin-bottom:0.5rem; letter-spacing:-0.5px; text-align:center;
        }
        .left-content .headline .hl-yellow {
            background:linear-gradient(135deg,var(--gold) 0%,var(--amber) 60%,var(--dark-amber) 100%);
            -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
        }
        .left-content .desc {
            font-size:0.9rem; line-height:1.7; color:var(--soft-gray);
            margin-bottom:2rem; max-width:400px; text-align:center;
            margin-left:auto; margin-right:auto;
        }

        .feature-cards {
            display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;
        }
        .feature-card {
            flex:1; min-width:120px; max-width:150px;
            display:flex; flex-direction:column; align-items:center; gap:0.5rem;
            padding:1rem 0.75rem; background:rgba(255,255,255,0.6);
            backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
            border:1px solid rgba(255,255,255,0.85);
            border-radius:var(--radius-md); box-shadow:var(--shadow-xs);
            transition:all var(--t-base); cursor:default;
        }
        .feature-card:hover {
            background:rgba(255,255,255,0.85); border-color:rgba(244,180,0,0.2);
            box-shadow:var(--shadow-md); transform:translateY(-3px);
        }
        .feature-card .fc-icon {
            width:40px; height:40px; border:1.5px solid rgba(244,180,0,0.25);
            border-radius:12px; display:flex; align-items:center; justify-content:center;
            color:var(--amber); font-size:1.1rem; flex-shrink:0;
            transition:all var(--t-base);
        }
        .feature-card:hover .fc-icon {
            border-color:var(--gold); background:rgba(255,213,74,0.12);
            box-shadow:0 0 20px rgba(255,213,74,0.15); color:var(--gold);
        }
        .feature-card .fc-label {
            font-size:0.75rem; color:var(--soft-gray); font-weight:500; text-align:center;
            line-height:1.3;
        }
        .feature-card .fc-label strong { color:var(--charcoal); font-weight:600; display:block; }

        .left-footer {
            position:relative; z-index:2; text-align:center;
            margin-top:1rem; opacity:0;
            animation:contentIn 0.7s ease 0.3s forwards;
        }
        /* ===== RIGHT PANEL ===== */
        .right-panel {
            flex:0 0 58%; display:flex; align-items:center; justify-content:center;
            padding:2rem; background:var(--off-white); position:relative; overflow:hidden;
        }
        .right-panel .bg-glow {
            position:absolute; top:-30%; right:-15%; width:700px; height:700px;
            background:radial-gradient(circle,rgba(255,213,74,0.06) 0%,transparent 65%);
            border-radius:50%; pointer-events:none;
        }
        .right-panel .bg-glow-2 {
            position:absolute; bottom:-25%; left:-10%; width:500px; height:500px;
            background:radial-gradient(circle,rgba(244,180,0,0.04) 0%,transparent 60%);
            border-radius:50%; pointer-events:none;
        }
        .right-panel .bg-grid {
            position:absolute; inset:0;
            background-image:
                linear-gradient(rgba(0,0,0,0.02) 1px,transparent 1px),
                linear-gradient(90deg,rgba(0,0,0,0.02) 1px,transparent 1px);
            background-size:50px 50px; pointer-events:none;
        }

        .auth-card {
            position:relative; z-index:3; width:100%; max-width:430px;
            background:rgba(255,255,255,0.88); backdrop-filter:blur(20px);
            -webkit-backdrop-filter:blur(20px);
            border:1px solid rgba(255,255,255,0.9);
            border-radius:var(--radius-xl);
            box-shadow:0 30px 80px rgba(0,0,0,0.06),0 8px 24px rgba(0,0,0,0.03),inset 0 1px 0 rgba(255,255,255,0.7);
            padding:2.75rem 2.5rem 2rem;
            opacity:0; animation:cardIn 0.7s ease 0.15s forwards;
        }
        @@keyframes cardIn {
            from { opacity:0; transform:translateY(24px) scale(0.97); }
            to { opacity:1; transform:translateY(0) scale(1); }
        }
        .auth-card::before {
            content:''; position:absolute; top:-1px; left:-1px; right:-1px;
            height:4px;
            background:linear-gradient(90deg,var(--gold) 0%,var(--amber) 40%,var(--dark-amber) 70%,var(--gold) 100%);
            background-size:300% 100%;
            border-radius:var(--radius-xl) var(--radius-xl) 0 0;
            animation:shimmer 5s linear infinite;
        }
        @@keyframes shimmer {
            0% { background-position:0% 0; }
            100% { background-position:300% 0; }
        }

        .auth-header {
            margin-bottom:1.75rem; text-align:center;
        }
        .auth-header h1 {
            font-family:var(--font-display); font-weight:800;
            font-size:1.65rem; color:var(--charcoal);
            margin-bottom:0.5rem; letter-spacing:-0.3px;
        }
        .auth-header .accent-line {
            width:50px; height:3.5px;
            background:linear-gradient(90deg,var(--gold),var(--amber));
            border-radius:4px; margin:0 auto 0.6rem;
        }
        .auth-header p {
            font-size:0.88rem; color:var(--soft-gray);
        }

        .form-group {
            margin-bottom:1.1rem; position:relative;
        }
        .form-group .input-wrap {
            position:relative; display:flex; align-items:center;
        }
        .form-group .input-icon {
            position:absolute; left:1rem; color:#9CA3AF; font-size:1rem;
            z-index:2; pointer-events:none; transition:color var(--t-fast);
        }
        .form-group .input-wrap:focus-within .input-icon { color:var(--amber); }

        .form-group .form-input {
            width:100%; padding:0.9rem 2.8rem 0.9rem 2.8rem;
            font-size:0.9rem; font-family:var(--font-body);
            color:var(--charcoal); background:var(--white);
            border:1.5px solid var(--border-light); border-radius:var(--radius-md);
            outline:none; transition:all var(--t-fast); box-shadow:var(--shadow-xs);
        }
        .form-group .form-input:focus {
            border-color:var(--gold);
            box-shadow:0 0 0 4px rgba(255,213,74,0.10),var(--shadow-sm);
            background:var(--white);
        }
        .form-group .form-input.error {
            border-color:#EF4444; box-shadow:0 0 0 4px rgba(239,68,68,0.08);
        }

        .form-group .fl-label {
            position:absolute; left:2.8rem; font-size:0.9rem;
            font-family:var(--font-body); color:#9CA3AF; pointer-events:none;
            transition:all var(--t-fast); background:var(--white); padding:0 4px;
            z-index:1; top:50%; transform:translateY(-50%); border-radius:2px; line-height:1;
        }
        .form-group .form-input:focus ~ .fl-label,
        .form-group .form-input:not(:placeholder-shown) ~ .fl-label {
            top:0; transform:translateY(-50%) scale(0.82); color:var(--amber); font-weight:500;
        }
        .form-group .form-input:focus ~ .fl-label { color:var(--amber); }

        .form-group .toggle-pw {
            position:absolute; right:0.7rem; background:none; border:none;
            color:#9CA3AF; cursor:pointer; padding:0.45rem; font-size:1.05rem;
            border-radius:8px; transition:all var(--t-fast); z-index:2;
            display:flex; align-items:center; justify-content:center;
        }
        .form-group .toggle-pw:hover { color:var(--soft-gray); background:var(--light-gray); }
        .form-group .toggle-pw:focus-visible { outline:2px solid var(--gold); outline-offset:2px; }

        .form-row {
            display:flex; align-items:center; justify-content:space-between;
            margin:0.4rem 0 1.3rem; gap:0.75rem;
        }
        .custom-check {
            display:flex; align-items:center; gap:0.5rem; cursor:pointer;
            user-select:none; font-size:0.84rem; color:var(--soft-gray);
        }
        .custom-check input { display:none; }
        .check-box {
            width:18px; height:18px; border:2px solid #D1D5DB; border-radius:5px;
            display:flex; align-items:center; justify-content:center; flex-shrink:0;
            transition:all var(--t-fast); background:var(--white);
        }
        .custom-check input:checked + .check-box {
            background:linear-gradient(135deg,var(--gold),var(--amber));
            border-color:var(--amber);
        }
        .custom-check input:checked + .check-box::after {
            content:'\2713'; color:var(--charcoal); font-size:11px; font-weight:700;
        }
        .custom-check input:focus-visible + .check-box {
            outline:2px solid var(--gold); outline-offset:2px;
        }
        .custom-check:hover .check-box { border-color:var(--amber); }

        .btn-primary {
            width:100%; padding:0.9rem 1.5rem; font-size:0.92rem;
            font-weight:600; font-family:var(--font-display);
            color:var(--charcoal);
            background:linear-gradient(135deg,var(--gold) 0%,var(--amber) 50%,var(--dark-amber) 100%);
            border:none; border-radius:var(--radius-md); cursor:pointer;
            transition:all var(--t-base); position:relative; overflow:hidden;
            display:flex; align-items:center; justify-content:center;
            gap:0.5rem; letter-spacing:0.2px; box-shadow:var(--shadow-glow);
        }
        .btn-primary:hover {
            transform:translateY(-2px); box-shadow:var(--shadow-glow-hover);
            background:linear-gradient(135deg,#FFE066 0%,var(--amber) 50%,#F4A100 100%);
        }
        .btn-primary:active { transform:translateY(0); box-shadow:var(--shadow-glow); }
        .btn-primary:focus-visible { outline:2px solid var(--charcoal); outline-offset:3px; }
        .btn-primary .ripple {
            position:absolute; border-radius:50%; background:rgba(51,51,51,0.10);
            transform:scale(0); animation:rippleAnim 0.6s ease-out; pointer-events:none;
        }
        @@keyframes rippleAnim { to { transform:scale(4); opacity:0; } }
        .btn-primary .spin {
            width:18px; height:18px; border:2.5px solid rgba(51,51,51,0.15);
            border-top-color:var(--charcoal); border-radius:50%;
            animation:rotate 0.6s linear infinite; display:none; flex-shrink:0;
        }
        .btn-primary.loading .spin { display:block; }
        .btn-primary.loading .btn-txt { display:none; }
        .btn-primary.loading { pointer-events:none; opacity:0.85; }
        @@keyframes rotate { to { transform:rotate(360deg); } }

        .error-toast {
            display:flex; align-items:center; gap:0.6rem;
            padding:0.7rem 0.9rem;
            background:rgba(254,242,242,0.9); backdrop-filter:blur(8px);
            border:1px solid #FECACA; border-radius:var(--radius-sm);
            margin-bottom:1.1rem; font-size:0.83rem; color:#991B1B;
            animation:errIn 0.35s ease;
        }
        .error-toast i { color:#EF4444; font-size:0.95rem; flex-shrink:0; }
        @@keyframes errIn {
            from { opacity:0; transform:translateY(-10px); }
            to { opacity:1; transform:translateY(0); }
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width:1100px) {
            .left-panel { flex:0 0 40%; padding:2rem 1.5rem 1.5rem; }
            .right-panel { flex:0 0 60%; padding:1.5rem; }
            .left-content .headline { font-size:2rem; }
            .auth-card { padding:2.25rem 2rem 1.75rem; }
            .feature-card { min-width:105px; padding:0.85rem 0.6rem; }
        }

        @@media (max-width:820px) {
            body { overflow:auto; }
            .split-layout { flex-direction:column; overflow-y:auto; min-height:100vh; }
            .left-panel { flex:0 0 auto; padding:2rem 1.5rem 1rem; min-height:35vh; }
            .right-panel { flex:0 0 auto; padding:1.5rem 1rem; min-height:auto; }
            .left-content { max-width:100%; }
            .left-content .headline { font-size:1.8rem; }
            .left-content .logo-wrap img { height:90px; }
            .auth-card { padding:1.75rem 1.5rem; max-width:100%; border-radius:var(--radius-lg); }
            .feature-card { min-width:110px; max-width:140px; }
            .left-footer { margin-top:0.75rem; }
        }

        @@media (max-width:480px) {
            .left-panel { padding:1.25rem 1rem 0.75rem; min-height:30vh; }
            .right-panel { padding:1rem 0.75rem; }
            .auth-card { padding:1.5rem 1.25rem 1.5rem; border-radius:20px; }
            .auth-header h1 { font-size:1.35rem; }
            .left-content .headline { font-size:1.5rem; }
            .left-content .desc { font-size:0.82rem; margin-bottom:1.25rem; }
            .left-content .logo-wrap { margin-bottom:1rem; }
            .left-content .logo-wrap img { height:75px; }
            .feature-cards { gap:0.5rem; }
            .feature-card { min-width:auto; max-width:none; padding:0.75rem 0.5rem; gap:0.35rem; }
            .feature-card .fc-icon { width:34px; height:34px; font-size:0.95rem; }
            .feature-card .fc-label { font-size:0.68rem; }
            .form-row { flex-direction:column; align-items:flex-start; gap:0.4rem; }
            .auth-card::before { border-radius:20px 20px 0 0; }
            .btn-primary { padding:0.8rem 1.25rem; font-size:0.88rem; }
        }

        /* ===== RTL ===== */
        [dir="rtl"] body { font-family:var(--font-arabic); }
        [dir="rtl"] .auth-card { direction:rtl; text-align:right; }
        [dir="rtl"] .auth-card input { text-align:right; }
        [dir="rtl"] .form-group .input-icon { left:auto; right:1rem; }
        [dir="rtl"] .form-group .form-input { padding:0.9rem 2.8rem 0.9rem 2.8rem; }
        [dir="rtl"] .form-group .fl-label { left:auto; right:2.8rem; }
        [dir="rtl"] .form-group .toggle-pw { right:auto; left:0.7rem; }
        [dir="rtl"] .left-content { direction:rtl; }
        [dir="rtl"] .left-content h1 { font-family:var(--font-arabic); }
        [dir="rtl"] .feature-card { direction:rtl; }
        [dir="rtl"] .custom-check { direction:rtl; }

        /* ===== REDUCED MOTION ===== */
        @@media (prefers-reduced-motion:reduce) {
            *,*::before,*::after {
                animation-duration:0.01ms!important; animation-iteration-count:1!important;
                transition-duration:0.01ms!important;
            }
            .left-content,.auth-card { opacity:1; animation:none; transform:none; }
            .feature-card:hover,.btn-primary:hover { transform:none; }
        }

        .sr-only {
            position:absolute; width:1px; height:1px; overflow:hidden;
            clip:rect(0,0,0,0); white-space:nowrap; border:0;
        }
    </style>
</head>
<body>
    <div class="split-layout">
        @* ===== LEFT PANEL ===== *@
        <div class="left-panel">
            <div class="bg-dots"></div>
            <div class="glow-orb"></div>
            <div class="glow-orb-2"></div>

            <div class="left-content">
                <div class="logo-wrap">
                    <img src="/logo.png" alt="@SharedLocalizer["Hack Gym"]" />
                </div>
                <h1 class="headline">
                    @SharedLocalizer["STRONGER"]<br>
                    <span class="hl-yellow">@SharedLocalizer["EVERY DAY"]</span>
                </h1>
                <p class="desc">
                    @SharedLocalizer["The all-in-one platform to manage members, workouts, subscriptions, trainers, and grow your fitness business."]
                </p>
                <div class="feature-cards">
                    <div class="feature-card">
                        <div class="fc-icon"><i class="bi bi-people"></i></div>
                        <span class="fc-label"><strong>@SharedLocalizer["Manage Members"]</strong> @SharedLocalizer["Profiles, attendance"]</span>
                    </div>
                    <div class="feature-card">
                        <div class="fc-icon"><i class="bi bi-graph-up-arrow"></i></div>
                        <span class="fc-label"><strong>@SharedLocalizer["Track Workouts"]</strong> @SharedLocalizer["Performance &amp; progress"]</span>
                    </div>
                    <div class="feature-card">
                        <div class="fc-icon"><i class="bi bi-bar-chart-fill"></i></div>
                        <span class="fc-label"><strong>@SharedLocalizer["Grow Business"]</strong> @SharedLocalizer["Analytics &amp; insights"]</span>
                    </div>
                </div>
            </div>

        </div>

        @* ===== RIGHT PANEL ===== *@
        <div class="right-panel">
            <div class="bg-glow"></div>
            <div class="bg-glow-2"></div>
            <div class="bg-grid"></div>

            <div class="auth-card">
                <div class="auth-header">
                    <h1>@SharedLocalizer["Welcome Back!"]</h1>
                    <div class="accent-line"></div>
                    <p>@SharedLocalizer["Sign in to your account to continue"]</p>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="error-toast" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@error</span>
                    </div>
                }

                <form method="post" action="/Account/Login" id="loginForm" novalidate>
                    <input type="hidden" name="captchaToken" id="captchaToken" />
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="username" class="sr-only">@SharedLocalizer["Username"]</label>
                        <div class="input-wrap">
                            <i class="bi bi-person input-icon" aria-hidden="true"></i>
                            <input type="text" id="username" name="username" class="form-input"
                                   placeholder=" " required autocomplete="username" autofocus />
                            <span class="fl-label" aria-hidden="true">@SharedLocalizer["Username"]</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password" class="sr-only">@SharedLocalizer["Password"]</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock input-icon" aria-hidden="true"></i>
                            <input type="password" id="password" name="password" class="form-input"
                                   placeholder=" " required autocomplete="current-password" />
                            <span class="fl-label" aria-hidden="true">@SharedLocalizer["Password"]</span>
                            <button type="button" class="toggle-pw" onclick="togglePassword()"
                                    aria-label="@SharedLocalizer["Show password"]" tabindex="-1">
                                <i class="bi bi-eye-slash" id="pwIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-row">
                        <label class="custom-check">
                            <input type="checkbox" name="remember" value="true" checked />
                            <span class="check-box"></span>
                            @SharedLocalizer["Remember me"]
                        </label>

                    </div>

                    <button type="submit" class="btn-primary" id="loginBtn">
                        <span class="spin"></span>
                        <span class="btn-txt"><i class="bi bi-box-arrow-in-right"></i> @SharedLocalizer["Sign In"]</span>
                    </button>
                </form>


            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            var pw = document.getElementById('password');
            var icon = document.getElementById('pwIcon');
            pw.type = pw.type === 'password' ? 'text' : 'password';
            icon.className = pw.type === 'password' ? 'bi bi-eye-slash' : 'bi bi-eye';
        }

        var form = document.getElementById('loginForm');
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            var btn = document.getElementById('loginBtn');
            if (btn.classList.contains('loading')) return;
            btn.classList.add('loading');

            var siteKey = '@ViewBag.CaptchaSiteKey';
            if (siteKey && typeof grecaptcha !== 'undefined') {
                grecaptcha.execute(siteKey, { action: 'login' }).then(function(token) {
                    document.getElementById('captchaToken').value = token;
                    HTMLFormElement.prototype.submit.call(form);
                }).catch(function() {
                    HTMLFormElement.prototype.submit.call(form);
                });
            } else {
                HTMLFormElement.prototype.submit.call(form);
            }
        });

        document.querySelector('.btn-primary').addEventListener('click', function(e) {
            if (this.classList.contains('loading')) return;
            var rect = this.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;
            var ripple = document.createElement('span');
            ripple.className = 'ripple';
            var size = Math.min(rect.width, rect.height) * 0.8;
            ripple.style.left = (x - size / 2) + 'px';
            ripple.style.top = (y - size / 2) + 'px';
            ripple.style.width = size + 'px';
            ripple.style.height = size + 'px';
            this.appendChild(ripple);
            setTimeout(function() { ripple.remove(); }, 600);
        });

        document.getElementById('username').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); document.getElementById('password').focus(); }
        });
        document.getElementById('password').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); document.getElementById('loginBtn').click(); }
        });
    </script>
</body>
</html>
