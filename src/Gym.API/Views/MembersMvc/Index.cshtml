@using Gym.Application.Members.DTOs
@model PaginatedResult<MemberDto>
@{
    var searchTerm = ViewBag.SearchTerm as string;
    var sortBy = ViewBag.SortBy as string;
    var sortDesc = (bool)(ViewBag.SortDescending ?? false);
}

<div class="receipt-card">
    <div class="receipt-header">
        <h4><i class="bi bi-people-fill"></i> @SharedLocalizer["Members"]</h4>
        <a asp-action="Create" class="btn btn-gold"><i class="bi bi-plus-lg"></i> @SharedLocalizer["Add Member"]</a>
    </div>
    @* WhatsApp Template Selector *@
    <div class="p-3 border-bottom bg-light">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-whatsapp text-success"></i></span>
                    <select id="whatsappTemplate" class="form-select">
                        <option value="">@SharedLocalizer["Select WhatsApp template..."]</option>
                        @if (ViewBag.WhatsAppTemplates is SelectList tpls)
                        {
                            foreach (var t in tpls)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-8 text-muted small d-flex align-items-center">
                <i class="bi bi-info-circle me-1"></i> @SharedLocalizer["Select a template above, then click the WhatsApp button on any row"]
            </div>
        </div>
    </div>

    <div class="p-3 border-bottom bg-light" style="border-top:1px solid var(--border-solid);">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" name="searchTerm" class="form-control" placeholder="@SharedLocalizer["Search by name, receipt, phone, or National ID..."]" value="@searchTerm" />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                </div>
            </div>
            <div class="col-md-2">
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    <option value="10" selected="@(Model?.PageSize == 10)">@SharedLocalizer["10 per page"]</option>
                    <option value="20" selected="@(Model?.PageSize == 20)">@SharedLocalizer["20 per page"]</option>
                    <option value="50" selected="@(Model?.PageSize == 50)">@SharedLocalizer["50 per page"]</option>
                </select>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="ExportExcel" class="btn btn-outline-success btn-sm rounded-pill"><i class="bi bi-download"></i> @SharedLocalizer["Export Excel"]</a>
                <a asp-action="Import" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-upload"></i> @SharedLocalizer["Import Excel"]</a>
                <a asp-action="Search" class="btn btn-outline-gold btn-sm rounded-pill"><i class="bi bi-search"></i> @SharedLocalizer["Advanced Search"]</a>
            </div>
        </form>
    </div>

    @if (Model is null || Model.Items.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-people-fill" style="font-size: 3rem;"></i>
            <p class="mt-2">@SharedLocalizer["No members found."]</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>@SharedLocalizer["Image"]</th>
                        <th>@SharedLocalizer["Member ID"]</th>
                        <th>@SharedLocalizer["Receipt ID"]</th>
                        <th>@SharedLocalizer["Name"]</th>
                        <th>@SharedLocalizer["Phone"]</th>
                        <th>@SharedLocalizer["Plan"]</th>
                        <th>@SharedLocalizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(member.ImagePath))
                                {
                                    <img src="~/@member.ImagePath" alt="" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="d-inline-block rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-size: 16px;">@member.FullName[0]</span>
                                }
                            </td>
                            <td><span class="fw-semibold">@member.Code</span></td>
                            <td><code style="font-size:0.8rem;color:var(--text-secondary);background:var(--light-gray);padding:2px 8px;border-radius:6px;">@member.ReceiptNumber</code></td>
                            <td>@member.FullName</td>
                            <td>@member.PhoneNumber</td>
                            <td>@(member.PackageName ?? "-")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@member.Id" class="btn btn-outline-primary" title="@SharedLocalizer["View"]"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@member.Id" class="btn btn-outline-secondary" title="@SharedLocalizer["Edit"]"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="PaymentHistory" asp-route-id="@member.Id" class="btn btn-outline-info" title="@SharedLocalizer["Payment History"]"><i class="bi bi-cash-coin"></i></a>
                                    <a asp-action="Delete" asp-route-id="@member.Id" class="btn btn-outline-danger" title="@SharedLocalizer["Delete"]"><i class="bi bi-trash"></i></a>
                                    <a href="#" class="btn btn-success wa-btn" title="@SharedLocalizer["WhatsApp"]"
                                        data-phone="@member.PhoneNumber"
                                        data-member="@member.FullName"
                                        data-receipt="@member.ReceiptNumber"
                                        data-code="@member.Code"
                                        data-joindate="@member.RegistrationDate.ToString("dd/MM/yyyy")"
                                        data-pdflink="@Url.Action("DownloadReceiptPdf", "Members", new { id = member.Id }, Context.Request.Scheme)"><i class="bi bi-whatsapp"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <small class="text-muted">@SharedLocalizer["Showing {0} of {1} members", Model.Items.Count, Model.TotalCount]</small>
            <nav>
                <ul class="pagination pagination-sm">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@searchTerm">@SharedLocalizer["Previous"]</a>
                        </li>
                    }
                    @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@searchTerm">@i</a>
                        </li>
                    }
                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@searchTerm">@SharedLocalizer["Next"]</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

<style>
    tr.wa-selected td { background-color: rgba(0, 0, 0, 0.2) !important; }
    @@media (prefers-color-scheme: dark) { tr.wa-selected td { background-color: rgba(200, 200, 200, 0.25) !important; } }
</style>

@section Scripts {
    <script>
        (function() {
            var templateData = @Html.Raw(ViewBag.WhatsAppTemplateJson ?? "[]");
            var templateMap = {};
            templateData.forEach(function(t) { templateMap[t.Id] = t.MessageBody; });

            var activeOffers = @Html.Raw(ViewBag.ActiveOffersJson ?? "[]");
            function formatOffer(o) {
                var lines = ['▸ ' + o.OfferTitle];
                var details = [];
                if (o.OfferPrice != null) details.push('@SharedLocalizer["Price"]: ' + Number(o.OfferPrice).toLocaleString() + ' @SharedLocalizer["EGP"]');
                if (o.OfferType === 'FixedPrice') {
                    details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Fixed Price"]');
                } else if (o.OfferType === 'BonusDuration') {
                    var bonus = [];
                    if (o.BonusMonths) bonus.push('+' + o.BonusMonths + ' @SharedLocalizer["month(s)"]');
                    if (o.BonusDays) bonus.push('+' + o.BonusDays + ' @SharedLocalizer["day(s)"]');
                    if (bonus.length) details.push('@SharedLocalizer["Bonus"]: ' + bonus.join(' + '));
                    details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Bonus Duration"]');
                } else if (o.OfferType === 'FreeRegistration') {
                    details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Free Registration"]');
                } else if (o.OfferType === 'ExtraFreeze') {
                    if (o.ExtraFreezeDays) details.push('@SharedLocalizer["Extra Freeze"]: +' + o.ExtraFreezeDays + ' @SharedLocalizer["day(s)"]');
                    details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Extra Freeze"]');
                } else if (o.OfferType === 'Custom') {
                    details.push('@SharedLocalizer["Type"]: @SharedLocalizer["Custom"]');
                }
                if (details.length) lines.push('  ' + details.join(' | '));
                return lines.join('\n');
            }
            var offersText = activeOffers.length > 0
                ? activeOffers.map(formatOffer).join('\n\n')
                : '';

            var select = document.getElementById('whatsappTemplate');

            document.addEventListener('click', function(e) {
                var btn = e.target.closest('.wa-btn');
                if (!btn) return;
                e.preventDefault();

                var tid = select ? select.value : '';
                if (!tid) {
                    showAlertModal('@SharedLocalizer["Please select a WhatsApp template first"]');
                    return;
                }

                var body = templateMap[tid] || '';
                var msg = body
                    .replace(/\{MemberName\}/g, btn.dataset.member || '')
                    .replace(/\{MemberCode\}/g, btn.dataset.code || '')
                    .replace(/\{JoinDate\}/g, btn.dataset.joindate || '')
                    .replace(/\{ReceiptNumber\}/g, btn.dataset.receipt || '')
                    .replace(/\{StartDate\}/g, '')
                    .replace(/\{ExpirationDate\}/g, '')
                    .replace(/\{DaysRemaining\}/g, '')
                    .replace(/\{SubscriptionStatus\}/g, '')
                    .replace(/\{TotalPaid\}/g, '')
                    .replace(/\{RemainingBalance\}/g, '')
                    .replace(/\{LastPaymentDate\}/g, '')
                    .replace(/\{LastPaymentAmount\}/g, '')
                    .replace(/\{PaymentMethod\}/g, '')
                    .replace(/\{Offers\}/g, offersText)
                    .replace(/\{OfferName\}/g, '')
                    .replace(/\{PdfLink\}/g, btn.dataset.pdflink || '');

                var row = btn.closest('tr');
                if (row) row.classList.add('wa-selected');

                var phone = (btn.dataset.phone || '').replace(/\D/g, '');
                if (phone.startsWith('0')) phone = '20' + phone.substring(1);
                window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(msg), '_blank');
            });
        })();
    </script>
}
