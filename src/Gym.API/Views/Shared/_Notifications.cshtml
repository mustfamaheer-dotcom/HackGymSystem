@{
    var successMsg = TempData["Success"] as string;
    var errorMsg = TempData["Error"] as string;
    var hasModelErrors = !ViewData.ModelState.IsValid;
    var hasAnyMessage = !string.IsNullOrEmpty(successMsg) || !string.IsNullOrEmpty(errorMsg) || hasModelErrors;
}

@if (hasAnyMessage)
{
    <div class="modal fade" id="appNotificationModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;border:none;box-shadow:0 20px 60px rgba(0,0,0,0.15);overflow:hidden;">
                @if (!string.IsNullOrEmpty(successMsg))
                {
                    <div style="background:linear-gradient(135deg,#059669,#10B981);padding:2rem 1.5rem;text-align:center;">
                        <div style="width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                            <i class="bi bi-check-circle" style="font-size:2rem;color:white;"></i>
                        </div>
                        <h5 style="color:white;font-weight:700;margin:0;">@SharedLocalizer["Success"]</h5>
                    </div>
                    <div class="modal-body" style="padding:1.5rem;">
                        <p style="margin:0;font-size:0.95rem;color:var(--text-primary);text-align:center;">@successMsg</p>
                    </div>
                    <div class="modal-footer" style="border:none;justify-content:center;padding:0 1.5rem 1.5rem;">
                        <button type="button" class="btn" data-bs-dismiss="modal" style="background:#059669;color:white;border-radius:10px;padding:0.6rem 2rem;font-weight:600;min-width:120px;">@SharedLocalizer["OK"]</button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(errorMsg))
                {
                    <div style="background:linear-gradient(135deg,#DC2626,#EF4444);padding:2rem 1.5rem;text-align:center;">
                        <div style="width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                            <i class="bi bi-x-circle" style="font-size:2rem;color:white;"></i>
                        </div>
                        <h5 style="color:white;font-weight:700;margin:0;">@SharedLocalizer["Error"]</h5>
                    </div>
                    <div class="modal-body" style="padding:1.5rem;">
                        <p style="margin:0;font-size:0.95rem;color:var(--text-primary);text-align:center;">@errorMsg</p>
                    </div>
                    <div class="modal-footer" style="border:none;justify-content:center;padding:0 1.5rem 1.5rem;">
                        <button type="button" class="btn" data-bs-dismiss="modal" style="background:#DC2626;color:white;border-radius:10px;padding:0.6rem 2rem;font-weight:600;min-width:120px;">@SharedLocalizer["OK"]</button>
                    </div>
                }
                else if (hasModelErrors)
                {
                    <div style="background:linear-gradient(135deg,#D97706,#F59E0B);padding:2rem 1.5rem;text-align:center;">
                        <div style="width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                            <i class="bi bi-exclamation-triangle" style="font-size:2rem;color:white;"></i>
                        </div>
                        <h5 style="color:white;font-weight:700;margin:0;">@SharedLocalizer["Validation Error"]</h5>
                    </div>
                    <div class="modal-body" style="padding:1.5rem;">
                        <p style="font-size:0.9rem;font-weight:600;color:var(--text-primary);margin:0 0 0.75rem;">@SharedLocalizer["Please fix the following errors:"]</p>
                        <ul style="margin:0;font-size:0.85rem;color:var(--text-muted-custom);padding-left:1.25rem;padding-right:0;">
                            @foreach (var state in ViewData.ModelState)
                            {
                                foreach (var err in state.Value.Errors)
                                {
                                    <li style="margin-bottom:0.25rem;">@err.ErrorMessage</li>
                                }
                            }
                        </ul>
                    </div>
                    <div class="modal-footer" style="border:none;justify-content:center;padding:0 1.5rem 1.5rem;">
                        <button type="button" class="btn" data-bs-dismiss="modal" style="background:#D97706;color:white;border-radius:10px;padding:0.6rem 2rem;font-weight:600;min-width:120px;">@SharedLocalizer["OK"]</button>
                    </div>
                }
            </div>
        </div>
    </div>
}
