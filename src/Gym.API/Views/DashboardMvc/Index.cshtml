                        <span style="font-size:0.78rem;color:var(--text-secondary);font-style:italic;">@SharedLocalizer[revReco]</span>
                    </div>
                </div>
            </div>

            <h5 style="font-family:'Poppins',sans-serif;font-weight:600;color:var(--charcoal);margin:0 0 1rem;display:flex;align-items:center;gap:0.5rem;">
