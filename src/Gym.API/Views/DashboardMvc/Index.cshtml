                                var colors = new[] { "#10B981", "#6366F1", "#F59E0B", "#3B82F6", "#EF4444", "#8B5CF6", "#EC4899", "#14B8A6" };
                                var ci = 0;
                                @foreach (var plan in Model.SubscriptionRevenueByPlan)
                                {
                                    var c = colors[ci % colors.Length];
                                    <div style="margin-bottom:0.85rem;">
                                        <div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:0.2rem;">
                                            <span class="insight-text">@plan.PlanName</span>
                                            <span>
                                                <span class="stat-value">@plan.TotalPaid.ToString("N2")</span>
                                                <span style="font-weight:400;color:var(--text-muted-custom);font-size:0.75rem;">(@plan.Percent%)</span>
                                            </span>
                                        </div>
                                        <div class="progress-thin"><div class="progress-fill" style="width:@(plan.Percent)%;background:linear-gradient(135deg,@c,transparent);"></div></div>
                                    </div>
                                    ci++;
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="dash-card">
                        <div class="dash-card-header"><i class="bi bi-journal-text"></i> @SharedLocalizer["Recent Subscriptions"]</div>
                        <div class="dash-card-body" style="padding:0.75rem 1.25rem;">
                            @if (Model.RecentSubscriptionActivity.Count == 0)
                            {
                                <p style="color:var(--text-muted-custom);font-size:0.85rem;text-align:center;padding:1rem 0;">@SharedLocalizer["No subscriptions yet."]</p>
                            }
                            else
                            {
                                <ul class="activity-feed" style="max-height:260px;overflow-y:auto;">
                                    @foreach (var activity in Model.RecentSubscriptionActivity)
                                    {
                                        var isOffer = activity.Type == "subscription_offer";
                                        <li>
                                            <div class="activity-icon" style="background:@(isOffer ? "rgba(245,158,11,0.15)" : "rgba(16,185,129,0.15)");">
                                                <i class="bi @(isOffer ? "bi-tag-fill" : "bi-journal-plus")" style="color:@(isOffer ? "#F59E0B" : "#10B981");"></i>
                                            </div>
                                            <div class="activity-content">
                                                <div class="act-desc">@activity.Description</div>
                                                <div class="act-time">@activity.Timestamp.ToString("dd MMM yyyy")</div>
                                            </div>
                                            <span class="act-time" style="white-space:nowrap;">@activity.Timestamp.ToString("HH:mm")</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* === GROUP: Subscriptions === *@
    <div class="group-section" id="group-subscriptions" style="display:none;">
        @* --- Subscriptions Business Analysis --- *@
        <div class="dash-card mb-4" style="border-left:4px solid #8B5CF6;">
            <div class="dash-card-body">
                <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
                    <div style="width:40px;height:40px;border-radius:12px;background:rgba(139,92,246,0.12);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:#8B5CF6;"><i class="bi bi-arrow-repeat"></i></div>
                    <div>
                        <div style="font-weight:700;font-size:0.9rem;color:var(--charcoal);">@SharedLocalizer["Business Analysis"] — @SharedLocalizer["Subscriptions"]</div>
                        <div style="font-size:0.72rem;color:var(--text-muted-custom);">@SharedLocalizer["Strengthen renewals and reduce churn"]</div>
                    </div>
                </div>
                @{
                    var overallRenewal = Model.OverallRenewalRate;
                    var bestRenewalPlan = Model.RenewalRateByPlan.Any()
                        ? Model.RenewalRateByPlan.OrderByDescending(r => r.RenewalRate).First()
                        : null;
                    var worstRenewalPlan = Model.RenewalRateByPlan.Any()
                        ? Model.RenewalRateByPlan.OrderBy(r => r.RenewalRate).First()
                        : null;
                    var totalFreezeImpact = Model.FreezeImpact.Any()
                        ? Model.FreezeImpact.Sum(f => f.Revenue)
                        : 0;
                    var totalExpectedRevenue = Model.FreezeImpact.Any()
                        ? Model.FreezeImpact.Sum(f => f.ExpectedSubscriptions)
                        : 0;
                    var subUtilization = Model.Subscriptions.TotalSubscriptions > 0
                        ? Math.Round(Model.Subscriptions.ActiveSubscriptions * 100.0 / Model.Subscriptions.TotalSubscriptions, 1)
                        : 0;
                }
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0.75rem;">
                    <div>
                        <div style="font-size:0.78rem;font-weight:600;color:var(--charcoal);margin-bottom:0.4rem;"><i class="bi bi-arrow-repeat" style="color:#8B5CF6;font-size:0.7rem;"></i> @SharedLocalizer["Renewal Performance"]</div>
                        <ul class="insight-list">
                            <li>
                                <span class="insight-dot" style="background:@(overallRenewal >= 50 ? "#10B981" : overallRenewal >= 30 ? "#F59E0B" : "#EF4444")"></span>
                                <span class="insight-text">@SharedLocalizer["Overall Renewal Rate"]</span>
                                <span class="insight-value">@overallRenewal%</span>
                            </li>
                            @if (bestRenewalPlan != null)
                            {
                                <li>
                                    <span class="insight-dot" style="background:#10B981"></span>
                                    <span class="insight-text">@SharedLocalizer["Best Renewal Plan"]</span>
                                    <span class="insight-value">@bestRenewalPlan.PlanName (@bestRenewalPlan.RenewalRate%)</span>
                                </li>
                            }
                            @if (worstRenewalPlan != null && worstRenewalPlan.PlanName != bestRenewalPlan?.PlanName)
                            {
                                <li>
                                    <span class="insight-dot" style="background:#EF4444"></span>
                                    <span class="insight-text">@SharedLocalizer["Lowest Renewal Plan"]</span>
                                    <span class="insight-value">@worstRenewalPlan.PlanName (@worstRenewalPlan.RenewalRate%)</span>
                                </li>
                            }
                        </ul>
                    </div>
                    <div>
                        <div style="font-size:0.78rem;font-weight:600;color:var(--charcoal);margin-bottom:0.4rem;"><i class="bi bi-snow2" style="color:#8B5CF6;font-size:0.7rem;"></i> @SharedLocalizer["Freeze & Retention"]</div>
                        <ul class="insight-list">
                            <li>
                                <span class="insight-dot" style="background:#3B82F6"></span>
                                <span class="insight-text">@SharedLocalizer["Freeze Revenue Impact"]</span>
                                <span class="insight-value" style="color:#EF4444;">@totalFreezeImpact.ToString("N2")</span>
                            </li>
                            <li>
                                <span class="insight-dot" style="background:#F59E0B"></span>
                                <span class="insight-text">@SharedLocalizer["Expected Revenue Lost"]</span>
                                <span class="insight-value">@totalExpectedRevenue</span>
                            </li>
                            <li>
                                <span class="insight-dot" style="background:#10B981"></span>
                                <span class="insight-text">@SharedLocalizer["Subscriptions with Offers"]</span>
                                <span class="insight-value">@Model.Subscriptions.SubscriptionsWithOffers</span>
                            </li>
                        </ul>
                    </div>
                    <div>
                        <div style="font-size:0.78rem;font-weight:600;color:var(--charcoal);margin-bottom:0.4rem;"><i class="bi bi-graph-up-arrow" style="color:#8B5CF6;font-size:0.7rem;"></i> @SharedLocalizer["Pipeline"]</div>
                        <ul class="insight-list">
                            <li>
                                <span class="insight-dot" style="background:@(subUtilization >= 60 ? "#10B981" : "#F59E0B")"></span>
                                <span class="insight-text">@SharedLocalizer["Subscription Utilization"]</span>
                                <span class="insight-value">@subUtilization%</span>
                            </li>
                            <li>
                                <span class="insight-dot" style="background:#6366F1"></span>
                                <span class="insight-text">@SharedLocalizer["Total Subscriptions"]</span>
                                <span class="insight-value">@Model.Subscriptions.TotalSubscriptions</span>
                            </li>
                            <li>
                                <span class="insight-dot" style="background:#8B5CF6"></span>
                                <span class="insight-text">@SharedLocalizer["Renewed This Period"]</span>
                                <span class="insight-value">@Model.Subscriptions.RenewedSubscriptions</span>
                            </li>
                        </ul>
                    </div>
                </div>
                @{
                    var subReco = string.Empty;
                    if (overallRenewal < 30)
                    {
                        subReco = "Renewal rate is critically low — audit the member experience at renewal touchpoints, offer a 'renew early' discount, and implement an automated reminder sequence starting 2 weeks before expiry.";
                    }
                    else if (totalFreezeImpact > 0 && worstRenewalPlan != null)
                    {
                        subReco = $"Freezes are costing {totalFreezeImpact.ToString("N2")} in lost revenue and \"{worstRenewalPlan.PlanName}\" has the lowest renewal rate. Review pricing and value perception for this plan, and offer a temporary downgrade option instead of freeze.";
                    }
                    else if (Model.Subscriptions.ExpiringNext7Days > 10)
                    {
                        subReco = "Over 10 subscriptions expiring within 7 days — deploy an urgent SMS/email campaign with a time-sensitive offer to maximize renewals before they lapse.";
                    }
                    else
                    {
                        subReco = "Subscription health is stable. Drive growth by promoting multi-month prepaid plans (higher lock-in) and referral rewards that give both parties a free month.";
                    }
                }
                <div style="margin-top:0.6rem;padding-top:0.6rem;border-top:1px solid var(--table-row-border);display:flex;gap:0.5rem;align-items:flex-start;">
                    <span style="font-size:0.75rem;color:#8B5CF6;"><i class="bi bi-chat-quote-fill"></i></span>
                    <span style="font-size:0.78rem;color:var(--text-secondary);font-style:italic;">@SharedLocalizer[subReco]</span>
                </div>
            </div>
        </div>

        <div class="kpi-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem;">
            <div class="kpi-card">
                <div class="kpi-accent" style="background:linear-gradient(135deg,#6366F1,#818CF8)"></div>
                <div class="kpi-top">
                    <div class="kpi-value">@Model.Subscriptions.TotalSubscriptions</div>
                    <div class="kpi-icon icon-bg-indigo"><i class="bi bi-journal-text"></i></div>
                </div>
                <div class="kpi-label">@SharedLocalizer["Total Subscriptions"]</div>
                <div class="kpi-sub"><span class="trend-up">+@Model.Subscriptions.ActiveSubscriptions</span> @SharedLocalizer["active"]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-accent" style="background:linear-gradient(135deg,#10B981,#34D399)"></div>
                <div class="kpi-top">
                    <div class="kpi-value">@Model.Subscriptions.ActiveSubscriptions</div>
                    <div class="kpi-icon icon-bg-green"><i class="bi bi-check-circle-fill"></i></div>
                </div>
                <div class="kpi-label">@SharedLocalizer["Active Subscriptions"]</div>
                <div class="kpi-sub"><span>@Model.Subscriptions.ActivePercent%</span> @SharedLocalizer["of total"]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-accent" style="background:linear-gradient(135deg,#F59E0B,#FBBF24)"></div>
                <div class="kpi-top">
                    <div class="kpi-value">@Model.Subscriptions.ExpiringNext7Days</div>
                    <div class="kpi-icon icon-bg-amber"><i class="bi bi-exclamation-triangle-fill"></i></div>
                </div>
                <div class="kpi-label">@SharedLocalizer["Expiring in 7 Days"]</div>
                <div class="kpi-sub"><span>@Model.Subscriptions.ExpiringNext30Days</span> @SharedLocalizer["expiring in 30 days"]</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-accent" style="background:linear-gradient(135deg,#8B5CF6,#A78BFA)"></div>
                <div class="kpi-top">
                    <div class="kpi-value">@Model.Subscriptions.FreezesThisMonth</div>
                    <div class="kpi-icon icon-bg-purple"><i class="bi bi-snow2"></i></div>
                </div>
                <div class="kpi-label">@SharedLocalizer["Freezes This Month"]</div>
                <div class="kpi-sub">&nbsp;</div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="dash-card">
                    <div class="dash-card-header"><i class="bi bi-arrow-repeat"></i> @SharedLocalizer["Renewal Rate by Plan"]</div>
                    <div class="dash-card-body">
                        @if (Model.RenewalRateByPlan.Count == 0)
                        {
                            <p style="color:var(--text-muted-custom);font-size:0.85rem;text-align:center;padding:1rem 0;">@SharedLocalizer["No subscription data."]</p>
                        }
                        else
                        {
                            <div style="margin-bottom:0.75rem;padding-bottom:0.75rem;border-bottom:1px solid var(--table-row-border);text-align:center;">
                                <span class="stat-label" style="display:block;font-size:0.75rem;">@SharedLocalizer["Overall Renewal Rate"]</span>
                                <span style="font-weight:700;font-size:1.25rem;color:#6366F1;">@Model.OverallRenewalRate%</span>
                            </div>
                            var rcolors = new[] { "#6366F1", "#10B981", "#F59E0B", "#EF4444", "#8B5CF6" };
                            var rci = 0;
                            @foreach (var plan in Model.RenewalRateByPlan)
                            {
                                var rc = rcolors[rci % rcolors.Length];
                                <div style="margin-bottom:0.65rem;">
                                    <div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:0.2rem;">
                                        <span class="insight-text">@plan.PlanName</span>
                                        <span>
                                            <span style="font-weight:600;color:@rc;">@plan.RenewalRate%</span>
                                            <span style="font-weight:400;color:var(--text-muted-custom);font-size:0.72rem;">(@plan.RenewedCount/@plan.TotalSubscriptions)</span>
                                        </span>
                                    </div>
                                    <div class="progress-thin"><div class="progress-fill" style="width:@(plan.RenewalRate)%;background:linear-gradient(135deg,@rc,transparent);"></div></div>
                                </div>
                                rci++;
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="dash-card">
                    <div class="dash-card-header"><i class="bi bi-snow2"></i> @SharedLocalizer["Freeze Impact (6 Months)"]</div>
                    <div class="dash-card-body">
                        @if (Model.FreezeImpact.Count == 0)
                        {
                            <p style="color:var(--text-muted-custom);font-size:0.85rem;text-align:center;padding:1rem 0;">@SharedLocalizer["No freeze data."]</p>
                        }
                        else
                        {
                            var maxFreeze = Model.FreezeImpact.Max(f => f.FreezeCount);
                            var freezeMax = maxFreeze > 0 ? maxFreeze : 1;
                            <div class="bar-chart">
                                @foreach (var item in Model.FreezeImpact)
                                {
                                    var heightPct = item.FreezeCount * 100.0 / freezeMax;
                                    <div class="bar-item">
                                        <span class="bar-value" style="font-size:0.65rem;">@item.FreezeCount</span>
                                        <div class="bar" style="height:@(heightPct)%;background:linear-gradient(180deg,#3B82F6,#60A5FA);"></div>
                                        <span class="bar-label" style="font-size:0.65rem;">@item.Label</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-12">
                <div class="dash-card">
                    <div class="dash-card-header"><i class="bi bi-journal-text"></i> @SharedLocalizer["Recent Subscriptions"]</div>
                    <div class="dash-card-body" style="padding:0.75rem 1.25rem;">
                        @if (Model.RecentSubscriptionActivity.Count == 0)
                        {
                            <p style="color:var(--text-muted-custom);font-size:0.85rem;text-align:center;padding:1rem 0;">@SharedLocalizer["No subscriptions yet."]</p>
                        }
                        else
                        {
                            <ul class="activity-feed" style="max-height:260px;overflow-y:auto;">
                                @foreach (var activity in Model.RecentSubscriptionActivity)
                                {
                                    var isOffer = activity.Type == "subscription_offer";
                                    <li>
                                        <div class="activity-icon" style="background:@(isOffer ? "rgba(245,158,11,0.15)" : "rgba(16,185,129,0.15)");">
                                            <i class="bi @(isOffer ? "bi-tag-fill" : "bi-journal-plus")" style="color:@(isOffer ? "#F59E0B" : "#10B981");"></i>
                                        </div>
                                        <div class="activity-content">
                                            <div class="act-desc">@activity.Description</div>
                                            <div class="act-time">@activity.Timestamp.ToString("dd MMM yyyy")</div>
                                        </div>
                                        <span class="act-time" style="white-space:nowrap;">@activity.Timestamp.ToString("HH:mm")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var buttons = document.querySelectorAll('.group-btn');
            var sections = {
                members: document.getElementById('group-members'),
                attendance: document.getElementById('group-attendance'),
                memberships: document.getElementById('group-memberships'),
                revenue: document.getElementById('group-revenue'),
                subscriptions: document.getElementById('group-subscriptions')
            };

            function showGroup(name) {
                Object.keys(sections).forEach(function(key) {
                    if (sections[key]) {
                        sections[key].style.display = key === name ? '' : 'none';
                    }
                });
                buttons.forEach(function(btn) {
                    var isActive = btn.dataset.group === name;
                    btn.classList.toggle('active', isActive);
                    btn.style.borderColor = isActive ? 'var(--amber)' : 'var(--border-solid)';
                    btn.style.boxShadow = isActive ? '0 4px 12px rgba(240,173,78,0.2)' : 'none';
                });
            }

            buttons.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    showGroup(this.dataset.group);
                });
            });

            showGroup('members');
        });
    </script>
}
