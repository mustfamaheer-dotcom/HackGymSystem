@using Gym.Application.Leads.Commands.CreateLead
@model CreateLeadCommand
@{

    var plans = ViewBag.Plans as IReadOnlyList<PlanDto> ?? new List<PlanDto>();
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="receipt-card">
            <div class="receipt-header">
                <h4><i class="bi bi-plus-circle"></i> @SharedLocalizer["New Lead"]</h4>
                <span class="receipt-badge">@SharedLocalizer["Lead"]</span>
            </div>
            <form asp-action="Create" method="post" class="receipt-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@SharedLocalizer["Gender"]</label>
                        <div class="d-flex gap-3 pt-1">
                            <label class="form-check">
                                <input type="radio" name="Gender" value="Male" class="form-check-input" />
                                <span class="form-check-label"><i class="bi bi-gender-male text-info"></i> @SharedLocalizer["Male"]</span>
                            </label>
                            <label class="form-check">
                                <input type="radio" name="Gender" value="Female" class="form-check-input" />
                                <span class="form-check-label"><i class="bi bi-gender-female text-danger"></i> @SharedLocalizer["Female"]</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Source" class="form-label">@SharedLocalizer["Source"]</label>
                        <select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()">
                            <option value="">@SharedLocalizer["-- Select --"]</option>
                        </select>
                        <span asp-validation-for="Source" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InterestedPackageId" class="form-label">@SharedLocalizer["Package"]</label>
                        <select asp-for="InterestedPackageId" class="form-select">
                            <option value="">@SharedLocalizer["-- Select --"]</option>
                            @foreach (var plan in plans)
                            {
                                <option value="@plan.Id">@plan.Name - @plan.Price.ToString("N2") @SharedLocalizer["EGP"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="receipt-footer px-0 pb-0 mt-3">
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg"></i> @SharedLocalizer["Cancel"]</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> @SharedLocalizer["Create"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
