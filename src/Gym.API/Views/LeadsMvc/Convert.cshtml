@using Gym.Application.Leads.DTOs
@model LeadDto
@{

    var plans = ViewBag.Plans as IReadOnlyList<PlanDto> ?? new List<PlanDto>();
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="receipt-card">
            <div class="receipt-header" style="background: linear-gradient(135deg, #D1FAE5, #A7F3D0);">
                <h4 class="text-success"><i class="bi bi-person-check"></i> @SharedLocalizer["Convert Lead to Member"]</h4>
                <span class="receipt-badge">@Model.Name</span>
            </div>
            <form asp-action="Convert" asp-route-id="@Model.Id" method="post" class="receipt-body">
                <input type="hidden" name="LeadId" value="@Model.Id" />
                <div class="mb-4 p-3 bg-light rounded">
                    <h6 class="fw-bold">@SharedLocalizer["Lead Information"]</h6>
                    <p class="mb-1">@SharedLocalizer["Name"]: @Model.Name</p>
                    <p class="mb-1">@SharedLocalizer["Phone"]: @Model.Phone</p>
                    <p class="mb-0">@SharedLocalizer["Source"]: @SharedLocalizer[Model.Source.ToString()]</p>
                </div>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">@SharedLocalizer["Membership Plan"]</label>
                        <select name="PlanId" class="form-select" required>
                            <option value="">@SharedLocalizer["-- Select Plan --"]</option>
                            @foreach (var plan in plans)
                            {
                                <option value="@plan.Id" selected="@(plan.Id == Model.InterestedPackageId ? "selected" : null)">
                                    @plan.Name - @plan.Price.ToString("N2") @SharedLocalizer["EGP"] (@plan.DurationDays @SharedLocalizer["day(s)"])
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@SharedLocalizer["Amount Paid"]</label>
                        <input name="AmountPaid" type="number" step="0.01" class="form-control" placeholder="@SharedLocalizer["e.g. 500"]" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@SharedLocalizer["Payment Method"]</label>
                        <select name="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()" required>
                            <option value="">@SharedLocalizer["-- Select --"]</option>
                        </select>
                    </div>
                </div>
                <div class="receipt-footer px-0 pb-0 mt-3">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-x-lg"></i> @SharedLocalizer["Cancel"]</a>
                    <button type="submit" class="btn btn-success"><i class="bi bi-person-check"></i> @SharedLocalizer["Convert to Member"]</button>
                </div>
            </form>
        </div>
    </div>
</div>